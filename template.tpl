___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const createArgumentsQueue = require('createArgumentsQueue');
const copyFromWindow = require('copyFromWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const getType = require('getType');
const makeString = require('makeString');
const makeInteger = require('makeInteger');
const makeNumber = require('makeNumber');
const makeTableMap = require('makeTableMap');
const Math = require('Math');
const Object = require('Object');
const sha256 = require('sha256');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const templateStorage = require('templateStorage');
const logToConsole = require('logToConsole');

const SDK_URL = 'https://bzrcdn.openai.com/sdk/oaiq.min.js';
const SDK_CACHE_KEY = 'openaiAdsWascer';
const CONSENT_TYPE = 'ad_storage';

const TYPE_BY_EVENT = {
  page_viewed: 'contents',
  contents_viewed: 'contents',
  items_added: 'contents',
  checkout_started: 'contents',
  order_created: 'contents',
  lead_created: 'customer_action',
  registration_completed: 'customer_action',
  appointment_scheduled: 'customer_action',
  subscription_created: 'plan_enrollment',
  trial_started: 'plan_enrollment',
  custom: 'custom'
};

const HASHED_FIELDS = ['email_sha256', 'external_id_sha256'];

const ZERO_DECIMAL_CURRENCIES = [
  'BIF', 'CLP', 'DJF', 'GNF', 'IDR', 'ISK', 'JPY', 'KMF', 'KRW',
  'MGA', 'PYG', 'RWF', 'UGX', 'VND', 'VUV', 'XAF', 'XOF', 'XPF'
];

const THREE_DECIMAL_CURRENCIES = ['BHD', 'IQD', 'JOD', 'KWD', 'LYD', 'OMR', 'TND'];

const MAX_LENGTH = {
  city: 128,
  zip_code: 32
};

const isCustomEvent = data.eventNameSource === 'custom';
const eventName = isCustomEvent ? 'custom' : data.eventNameStandard;

let settled = false;

function onSuccess() {
  if (settled) return;
  settled = true;
  data.gtmOnSuccess();
}

function onFailure() {
  if (settled) return;
  settled = true;
  data.gtmOnFailure();
}

function debugLog(label, payload) {
  if (!data.debug) return;
  logToConsole('Wascer OpenAI Ads Pixel', label, payload);
}

function getQueue() {
  const existing = copyFromWindow('oaiq');
  if (getType(existing) === 'function') return existing;
  return createArgumentsQueue('oaiq', 'oaiq.q');
}

function asObject(value) {
  return getType(value) === 'object' ? value : {};
}

function asArray(value) {
  return getType(value) === 'array' ? value : [];
}

function isFilled(value) {
  return value !== undefined && value !== null && value !== '';
}

function pick(source, keys) {
  for (let i = 0; i < keys.length; i++) {
    const value = source[keys[i]];
    if (isFilled(value)) return value;
  }
  return undefined;
}

function firstFilled(primary, fallback) {
  return isFilled(primary) ? primary : fallback;
}

function assign(target, key, value) {
  if (!isFilled(value)) return;
  target[key] = value;
}

function isHashed(value) {
  return !!makeString(value).match('^[A-Fa-f0-9]{64}$');
}

function normalize(key, value) {
  let text = makeString(value).trim();
  if (key === 'email_sha256' || key === 'city') {
    text = text.toLowerCase();
  }
  if (key === 'country') {
    text = text.toUpperCase();
  }
  if (MAX_LENGTH[key] && text.length > MAX_LENGTH[key]) {
    text = text.substring(0, MAX_LENGTH[key]);
  }
  return text;
}

function readAddress(userData) {
  const address = userData.address;
  if (getType(address) === 'array') return asObject(address[0]);
  return asObject(address);
}

function collectFromDataLayer(user) {
  const userData = asObject(copyFromDataLayer('user_data', 2));
  const address = readAddress(userData);
  assign(user, 'email_sha256', pick(userData, ['email_sha256', 'sha256_email_address', 'email_address', 'email']));
  assign(user, 'external_id_sha256', pick(userData, ['external_id_sha256', 'external_id', 'user_id']));
  assign(user, 'country', pick(userData, ['country']) || pick(address, ['country']));
  assign(user, 'city', pick(userData, ['city']) || pick(address, ['city']));
  assign(user, 'zip_code', pick(userData, ['zip_code']) || pick(address, ['postal_code']));
}

function collectFromTable(user) {
  const table = makeTableMap(asArray(data.userDataTable), 'name', 'value');
  if (!table) return;
  Object.keys(table).forEach(function (key) {
    assign(user, key, table[key]);
  });
}

function hashUserData(user, onDone) {
  let pending = 0;
  let queued = false;

  function maybeDone() {
    if (queued && pending === 0) onDone(user);
  }

  Object.keys(user).forEach(function (key) {
    if (HASHED_FIELDS.indexOf(key) === -1) return;
    const value = user[key];
    if (isHashed(value)) {
      user[key] = value.toLowerCase();
      return;
    }
    pending = pending + 1;
    sha256(value, function (digest) {
      user[key] = digest;
      pending = pending - 1;
      maybeDone();
    }, function () {
      Object.delete(user, key);
      pending = pending - 1;
      maybeDone();
    }, {
      outputEncoding: 'hex'
    });
  });

  queued = true;
  maybeDone();
}

function buildUserData(onDone) {
  const user = {};

  if (data.useAdvancedMatching) {
    collectFromDataLayer(user);
  }
  collectFromTable(user);

  Object.keys(user).forEach(function (key) {
    const normalized = normalize(key, user[key]);
    if (normalized === '') {
      Object.delete(user, key);
      return;
    }
    user[key] = normalized;
  });

  hashUserData(user, onDone);
}

function currencyMultiplier(currency) {
  if (ZERO_DECIMAL_CURRENCIES.indexOf(currency) !== -1) return 1;
  if (THREE_DECIMAL_CURRENCIES.indexOf(currency) !== -1) return 1000;
  return 100;
}

function toMinorUnit(value, currency) {
  if (!isFilled(value)) return undefined;
  const amount = makeNumber(value);
  if (getType(amount) !== 'number' || amount !== amount) return undefined;
  return makeInteger(Math.round(amount * currencyMultiplier(currency)));
}

function buildContents(items, currency) {
  const contents = [];
  items.forEach(function (item) {
    if (getType(item) !== 'object') return;
    const content = {
      content_type: 'product'
    };
    assign(content, 'id', isFilled(item.item_id) ? makeString(item.item_id) : undefined);
    assign(content, 'name', isFilled(item.item_name) ? makeString(item.item_name) : undefined);
    content.quantity = isFilled(item.quantity) ? makeInteger(item.quantity) : 1;

    const itemCurrency = isFilled(item.currency) ? makeString(item.currency).trim().toUpperCase() : currency;
    const amount = toMinorUnit(item.price, itemCurrency);
    if (amount !== undefined && itemCurrency) {
      content.amount = amount;
      content.currency = itemCurrency;
    }
    contents.push(content);
  });
  return contents;
}

function sumContents(contents) {
  let total = 0;
  let found = false;
  contents.forEach(function (content) {
    if (content.amount === undefined) return;
    total = total + content.amount * content.quantity;
    found = true;
  });
  return found ? makeInteger(Math.round(total)) : undefined;
}

function buildEventData() {
  const eventData = {
    type: TYPE_BY_EVENT[eventName] || 'custom'
  };

  if (!data.useDataLayer) return eventData;

  const ecommerce = asObject(copyFromDataLayer('ecommerce', 2));
  const rawCurrency = firstFilled(copyFromDataLayer('currency', 2), ecommerce.currency);
  const rawValue = firstFilled(copyFromDataLayer('value', 2), ecommerce.value);
  const rawItems = firstFilled(copyFromDataLayer('items', 2), ecommerce.items);

  const currency = isFilled(rawCurrency) ? makeString(rawCurrency).trim().toUpperCase() : undefined;
  const contents = buildContents(asArray(rawItems), currency);

  if (contents.length > 0 && eventData.type !== 'customer_action') {
    eventData.contents = contents;
  }

  if (currency) {
    eventData.currency = currency;
    let amount = toMinorUnit(rawValue, currency);
    if (amount === undefined && contents.length > 0) {
      amount = sumContents(contents);
    }
    if (amount !== undefined) {
      eventData.amount = amount;
    }
  }

  return eventData;
}

function buildOptions() {
  const options = {
    opt_out: data.optOut === true
  };
  if (isFilled(data.eventId)) {
    options.event_id = makeString(data.eventId);
  }
  if (isCustomEvent) {
    options.custom_event_name = makeString(data.eventNameCustom);
  }
  return options;
}

function send() {
  buildUserData(function (user) {
    const queue = getQueue();

    const initData = {
      pixelId: data.pixelId
    };
    if (data.debug) {
      initData.debug = true;
    }
    if (Object.keys(user).length > 0) {
      initData.user = user;
    }

    const eventData = buildEventData();
    const options = buildOptions();

    debugLog('init', initData);
    debugLog('measure ' + eventName, eventData);

    queue('init', initData);
    queue('measure', eventName, eventData, options);

    injectScript(SDK_URL, onSuccess, onFailure, SDK_CACHE_KEY);
  });
}

function waitForConsent() {
  const listenerKey = 'consent_listener_' + makeString(data.pixelId) + '_' + makeString(eventName);
  if (!templateStorage.getItem(listenerKey)) {
    templateStorage.setItem(listenerKey, true);
    addConsentListener(CONSENT_TYPE, function (consentType, granted) {
      if (!granted) return;
      templateStorage.setItem(listenerKey, false);
      send();
    });
  }
  onSuccess();
}

function main() {
  if (data.consentMode === 'gcm' && !isConsentGranted(CONSENT_TYPE)) {
    debugLog('waiting for consent', CONSENT_TYPE);
    waitForConsent();
    return;
  }
  send();
}

main();


