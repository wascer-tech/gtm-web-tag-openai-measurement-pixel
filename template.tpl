___TESTS___

scenarios:
- name: Standard event sends init and measure with the right type
  code: |-
    const mockData = {
      pixelId: 'pix_123',
      eventNameSource: 'standard',
      eventNameStandard: 'order_created',
      eventId: 'evt_1',
      useDataLayer: true,
      useAdvancedMatching: false,
      consentMode: 'always',
      optOut: false,
      debug: false
    };

    let calls = [];
    mockQueue(calls);
    mockDataLayer({
      value: 25.99,
      currency: 'USD',
      items: [{item_id: 'sku_1', item_name: 'Blue mug', price: 25.99, quantity: 2}]
    });
    mock('injectScript', function (url, onSuccess) {
      assertThat(url).isEqualTo('https://bzrcdn.openai.com/sdk/oaiq.min.js');
      onSuccess();
    });

    runCode(mockData);

    assertThat(calls.length).isEqualTo(2);
    assertThat(calls[0][0]).isEqualTo('init');
    assertThat(calls[0][1].pixelId).isEqualTo('pix_123');
    assertThat(calls[1][0]).isEqualTo('measure');
    assertThat(calls[1][1]).isEqualTo('order_created');
    assertThat(calls[1][2].type).isEqualTo('contents');
    assertThat(calls[1][2].amount).isEqualTo(2599);
    assertThat(calls[1][2].currency).isEqualTo('USD');
    assertThat(calls[1][2].contents[0].id).isEqualTo('sku_1');
    assertThat(calls[1][2].contents[0].name).isEqualTo('Blue mug');
    assertThat(calls[1][2].contents[0].content_type).isEqualTo('product');
    assertThat(calls[1][2].contents[0].quantity).isEqualTo(2);
    assertThat(calls[1][2].contents[0].amount).isEqualTo(2599);
    assertThat(calls[1][3].event_id).isEqualTo('evt_1');
    assertApi('gtmOnSuccess').wasCalled();
- name: Custom event carries custom_event_name
  code: |-
    const mockData = {
      pixelId: 'pix_123',
      eventNameSource: 'custom',
      eventNameCustom: 'quote-requested',
      useDataLayer: false,
      useAdvancedMatching: false,
      consentMode: 'always',
      optOut: true,
      debug: false
    };

    let calls = [];
    mockQueue(calls);
    mockDataLayer({});
    mock('injectScript', function (url, onSuccess) {
      onSuccess();
    });

    runCode(mockData);

    assertThat(calls[1][1]).isEqualTo('custom');
    assertThat(calls[1][2].type).isEqualTo('custom');
