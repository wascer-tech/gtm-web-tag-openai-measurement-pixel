- name: An existing queue on the page is reused
  code: |-
    const mockData = {
      pixelId: 'pix_123',
      eventNameSource: 'standard',
      eventNameStandard: 'page_viewed',
      useDataLayer: false,
      useAdvancedMatching: false,
      consentMode: 'always',
      optOut: false,
      debug: false
    };

    let calls = [];
    mock('copyFromWindow', function (key) {
      if (key !== 'oaiq') return undefined;
      return function (command, a, b, c) {
        calls.push([command, a, b, c]);
      };
    });
    mock('createArgumentsQueue', function () {
      fail('The template must reuse the queue that is already on the page.');
    });
    mockDataLayer({});
    mock('injectScript', function (url, onSuccess) {
      onSuccess();
    });

    runCode(mockData);

    assertThat(calls.length).isEqualTo(2);
    assertThat(calls[0][0]).isEqualTo('init');
    assertApi('gtmOnSuccess').wasCalled();
setup: |-
  const mockQueue = function (calls) {
    mock('copyFromWindow', function () {
      return undefined;
    });
    mock('createArgumentsQueue', function () {
      return function (command, a, b, c) {
        calls.push([command, a, b, c]);
      };
    });
  };

  const mockDataLayer = function (values) {
    mock('copyFromDataLayer', function (key) {
      return values[key];
    });
  };


___NOTES___

The web pixel does not accept app_installed or app_opened. Those two events only exist in the OpenAI Conversions API, so send them from the server tag.

Fill the Event ID field with the same value you send in the server tag. OpenAI uses it to merge the two hits into one conversion.

If the site runs a Content Security Policy, allow script-src https://bzrcdn.openai.com, connect-src https://bzr.openai.com and https://bzrcdn.openai.com, and img-src https://bzr.openai.com.
